# Impostazioni opzionali. Lascia il modello vuoto per l’analisi deterministica.
# Esempio per Ollama in locale con un modello che supporta le chiamate a strumenti.
GASOPS_LLM_URL=http://127.0.0.1:11434/v1
GASOPS_LLM_MODEL=
# Token opzionale per un endpoint HTTPS compatibile con OpenAI.
GASOPS_LLM_API_KEY=

# Cartelle predefinite nella copia locale: ./data/regulatory e ./.gasops.
# GASOPS_PDF_DIR=/percorso/assoluto/ai/pdf
# GASOPS_STATE_DIR=/percorso/assoluto/ai/dati-locali
