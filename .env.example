# Impostazioni opzionali. Lascia il modello vuoto per l’analisi deterministica.
# Esempio per Ollama in locale con un modello che supporta le chiamate a strumenti.
GASOPS_LLM_URL=http://127.0.0.1:11434/v1
GASOPS_LLM_MODEL=
# Token opzionale per un endpoint HTTPS compatibile con OpenAI.
GASOPS_LLM_API_KEY=

# Cartelle predefinite nella copia locale: ./data/regulatory e ./.gasops.
# Profilo server: public_demo (default), private_workbench, test.
# GASOPS_APP_MODE=workbench cambia solo il layout: NON concede privilegi.
GASOPS_PROFILE=public_demo
# Workbench privato: configurare prima OIDC [auth] nei Secrets Streamlit.
# Sono necessari issuer, subject autorizzati e claim exp non scaduto.
# GASOPS_AUTH_ISSUER=https://issuer.example
# GASOPS_PRIVATE_SUBJECTS=subject-operator-1,subject-operator-2
# GASOPS_PDF_DIR viene ignorata nella demo pubblica, che legge solo
# data/public-regulatory. Gli upload dei visitatori restano nella sessione.
# GASOPS_PDF_DIR=/percorso/assoluto/ai/pdf
# GASOPS_STATE_DIR=/percorso/assoluto/ai/dati-locali

# Opzionale: stessa chiave personale gratuita per GIE AGSI+, ALSI, IIP.
# Mai committare un valore reale. GASOPS_AGSI_API_KEY resta un alias compatibile.
GASOPS_GIE_API_KEY=

# Groq free tier: set three GASOPS_LLM_* fields or GROQ_API_KEY alone.
# GASOPS_LLM_URL=https://api.groq.com/openai/v1
# GASOPS_LLM_MODEL=openai/gpt-oss-120b
# Non-Groq HTTPS providers are blocked unless explicitly enabled (may incur charges).
GASOPS_ALLOW_PAID_LLM=false

# API Terna (server-only; optional; never commit real credentials)
GASOPS_TERNA_CLIENT_ID=
GASOPS_TERNA_CLIENT_SECRET=
# Set only after confirming the interval semantics for the private monitor.
GASOPS_TERNA_INTERVAL_START=0
# Public Streamlit demo: report history stays in session. Keep disabled.
# Explicit non-UI private callers may opt in with =1 AND persist=True.
GASOPS_PRIVATE_RUN_HISTORY=0
