# Optional. Leave GASOPS_LLM_MODEL empty for deterministic offline execution.
# For a locally installed Ollama model that supports tool calls:
GASOPS_LLM_URL=http://127.0.0.1:11434/v1
GASOPS_LLM_MODEL=
# Optional bearer token for a configured HTTPS OpenAI-compatible endpoint.
GASOPS_LLM_API_KEY=

# Defaults to ./data/regulatory and ./.gasops in this checkout.
# GASOPS_PDF_DIR=/absolute/path/to/pdf-folder
# GASOPS_STATE_DIR=/absolute/path/to/local-state-folder
